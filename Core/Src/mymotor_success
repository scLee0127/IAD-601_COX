// global variable
// MOTOR
#define SWITCH_DELAY_MS     100
#define RAMP_UP_PER_STEP    0.01f
#define RAMP_DOWN_PER_STEP  0.02f  		// 감속은 빠르게
#define MIN_DUTY            0.05f  		// 1% (정지마찰만 겨우 이기는 수준)
#define MAX_DUTY            0.25f

typedef enum { 
	SD_IDLE = 0, 
	SD_RUN, 
	SD_SWITCH_PAUSE 
}eSD_STATE_T;

eSD_STATE_T geState = SD_IDLE;

static int gnCmd_Dir = 0;
static float gnfCmd_Speed = 0.0f;
static int gnCur_Dir   = 0;
static float gnfCur_Pwm   = 0.0f;
static uint32_t gnT_Switch  = 0;

static volatile float g_min_speed = 0.01f;     // 최소 PWM (모터 정지마찰 극복)
static volatile float g_deadband  = 3.0f;      // ±2Pa 내면 정지


// PID
typedef struct {
    float kp, ki, kd;
    float dt;                 // [s], 예: 0.01f (10ms)
    float out_min, out_max;   // 출력 한계 [-1..+1]
    float i_min, i_max;       // 적분 한계
    float d_hz;               // D 저역통과 컷오프(Hz), 0이면 비활성

    // 내부 상태
    float integrator;
    float prev_err;
    float d_state;
    uint8_t first_run;

    // 안정화 구간
    float settle_band;
    float settle_scale;
    float u_slew;
    float prev_u;
} MYPID_t;
static MYPID_t gstPid;
static volatile float g_target_pa = 50.0f;     // 목표 차압

uint32_t gnMotorTick_prev = 0;
uint32_t gnAcc2ms = 0;
uint32_t gnAcc10ms = 0;

// Block hunting
#define BLANK_AFTER_LIMIT_MS 		500  		// 리미트 직후 블록킹
#define DB_IN_PA 					4.0f  		// 데드밴드 진입(정지)
#define DB_OUT_PA  					12.0f  		// 데드밴드 탈출 마진(슈미트)
#define DB_HOLD_MS  				1000 			// 제기동 최소 유지
#define Y_SLEW_PA_PER_20MS  		8.0f  		// 20ms당 측정값 최대 변화량 제한
#define DIR_THR 					0.08f  		// 아주 작은 출력 무시
#define DIR_HOLD_MS  				40  		// 방향 전환 전에 같은 부호 유지해야
static uint8_t gcnBlank_Active = 0;
static uint32_t gnBlank_t0_ms = 0;
static uint8_t gcnDB_Hold = 0;
static uint32_t gnDB_Out_ms = 0;
static float gnfY_Filt = 0.0f;  				// LPF+슬루 적용 측정값
static float gnfY_Prev = 0.0f;
static int gnLast_Dir = 0;
static uint32_t gnDir_Hold_ms = 0;
static uint8_t gcnPrevClose = 0;  				// 리미트 에지 검출
static uint8_t gcnPrevOpen = 0;  				// 리미트 에지 검출

// gcnFireEvent_f 엣지 감지 (PID 상태 리셋 & 1→0 즉시 정지 조건 처리)
static uint8_t prevFire = 0xFF;
static uint8_t s_close_hold = 0;
static uint8_t gcnOverCurrent_Err = 0;

